# Copy to .env and adjust. Loaded by scripts/deploy-all.sh and docker-compose.

# App image
IMAGE_NAME=demo-app
IMAGE_TAG=0.2.0

# Registry for CI/CD (GitHub Container Registry)
REGISTRY=ghcr.io
REPOSITORY=your-org/your-repo

# Slack incoming webhook for Alertmanager (optional locally, required for prod alerts)
SLACK_WEBHOOK_URL=

# Ollama for the AI incident service (k8s/ai/). Empty keeps the ConfigMap
# value, http://host.minikube.internal:11434 (Ollama on the Minikube host).
# k3s in Docker: http://172.17.0.1:11434. Ollama must listen on that address
# (OLLAMA_HOST=172.17.0.1:11434), not on 0.0.0.0: its API has no authentication.
OLLAMA_URL=

# scripts/demo.sh (see docs/DEMO.md)
# Ollama binary and model store, if not the defaults (ollama on PATH, ~/.ollama/models)
OLLAMA_BIN=
OLLAMA_MODELS=
# Address Ollama listens on when demo.sh starts it (default: where the pods
# reach the host, e.g. the Docker bridge 172.17.0.1 for k3s)
OLLAMA_BIND=
# auto (an existing k3s container, else the current context, else a new k3s
# container), k3s-docker or minikube
CLUSTER=auto
K3S_CONTAINER=k3s-demo
# 1 = delete Docker's copy of the images once they are loaded into k3s
PRUNE_HOST_IMAGES=

# Ingress host (update k8s/ingress.yaml to match)
INGRESS_HOST=demo.local

# kubeconfig context used by deploy scripts (leave empty to use current context)
KUBE_CONTEXT=

# Dashboard: GitHub repository whose Actions status is shown on :9983.
# Derived from the git remote by scripts/start-dashboard.sh when left empty.
GITHUB_REPOSITORY=
# Optional: raises the GitHub API rate limit (public repos work without it).
GITHUB_TOKEN=
# Local port for the dashboard.
DASHBOARD_PORT=9983
